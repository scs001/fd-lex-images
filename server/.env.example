# fd-lex-api 环境变量样例（同名环境变量优先；全部有条目即可跑默认值）

# lex 库连接串（计量 metering_* + 账本 billing_* 同库）
DATABASE_URL=sqlite:///./fd_lex_dev.db

# sub2api 计费面 admin API（与 fd-wire 同一生产设施、同一契约端点）
SUB2API_BASE=https://router.finddatatech.cloud
SUB2API_ADMIN_KEY=

# /internal/* 端点 bearer 令牌；未配置时 fail-closed（403）。
# 骨架期简单 bearer，接 Logto 后收敛（billing/deps.py）。
INTERNAL_API_TOKEN=

# 平台服务身份名单（逗号分隔 username，大小写不敏感）；
# 命中 → credential_track=platform（不进客户账单），否则 customer。
PLATFORM_IDENTITIES=

# registry Mongo 审计流直读（audit 流消费的可选路径；URI 未配置时禁用）
REGISTRY_MONGO_URI=
REGISTRY_MONGO_DB=
REGISTRY_MONGO_COLLECTION=audit_events

# audit 流单轮消费批量上限
METERING_POLL_LIMIT=500

# 启动时 create_all（开发便利；生产迁移链收敛后可关）
METERING_AUTO_CREATE_TABLES=true

# --- 交付包分发面（/api/distribution） -----------------------------------
# packer 产出的 bundle 目录树（只读扫描；每子目录含 manifest.json/pack.tar/
# pack.tar.sha256/data/*.jsonl.gz）。生产挂载交付包制品盘。
DISTRIBUTION_ROOT=./distribution_packs
# 分发面 bearer 令牌；未配置 fail-closed（403）。
# v1 客户侧定时任务共用该令牌；客户级凭据（wgk-）接 Logto 后演进（后续项）。
DISTRIBUTION_API_TOKEN=

# --- 控制台（/api/console）与运营后台（/api/admin）面 ---------------------
# 控制台登录：Logto SPA（authorization code + PKCE，浏览器侧完成）。
# 服务端只做 ID token 本地校验（JWKS/iss/aud）与 access token 透传代理，
# 不持有客户端密钥。issuer 例：https://auth.finddatatech.cloud（issuer 取其 + /oidc）。
LOGTO_ISSUER=
# 控制台 SPA 应用的 client_id（需在 Logto 新建 SPA 应用；redirect URI 见部署文档）
LOGTO_CLIENT_ID=
# 控制台请求的 Logto API resource：须等于 registry auth-server 接受的 audience
# （LOGTO_M2M_RESOURCE，默认 https://mcp.finddatatech.cloud/api）
LOGTO_RESOURCE=https://mcp.finddatatech.cloud/api
# 组织门禁：非空时要求 ID token organizations claim 命中其一（外部客户隔离）。
# 例：LOGTO_REQUIRED_ORG_IDS=hnrbfpgq2717（lex-customers）
LOGTO_REQUIRED_ORG_IDS=
# 控制台登录 scope（Logto 第一方应用）
CONSOLE_SCOPES=openid profile email roles offline_access urn:logto:scope:organizations
# 运营后台角色门禁：命中 ID token roles claim 任一即放行（Logto 角色名）
ADMIN_ROLES=lex-admin
# registry 面（凭据代理目标；Caddy /api 之外的显式借用契约端点）
REGISTRY_BASE_URL=https://mcp.finddatatech.cloud
# 控制台站点 origin（回跳提示用）
CONSOLE_ORIGIN=https://lex.finddatatech.cloud
# registry patch-keys 代理超时（秒）
REGISTRY_TIMEOUT_SECONDS=10

# 构建版本（CI/部署注入）
BUILD_VERSION=dev
