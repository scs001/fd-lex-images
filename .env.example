# fd-lex server 侧配置占位（骨架期全部可留空，零配置即可启动）
# 复制为 .env 后按需修改；全部走环境变量。

# 构建版本：CI/部署注入（镜像 tag / ArgoCD）；本地留空则 /api/version 返回 dev
BUILD_VERSION=

# --- 以下为后续落位预留（lex-platform-v1 计量结算/分发/后台链） ---
# 服务监听
FD_LEX_HOST=0.0.0.0
FD_LEX_PORT=8000

# Logto（lex-customers org）接入：控制台登录（4.3）
# 详见 server/.env.example 与 deploy/README.md 的「外部配置清单」
LOGTO_ISSUER=https://auth.finddatatech.cloud
LOGTO_CLIENT_ID=
LOGTO_RESOURCE=https://mcp.finddatatech.cloud/api
LOGTO_REQUIRED_ORG_IDS=hnrbfpgq2717
ADMIN_ROLES=lex-admin
REGISTRY_BASE_URL=https://mcp.finddatatech.cloud
CONSOLE_ORIGIN=https://lex.finddatatech.cloud
